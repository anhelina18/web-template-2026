<a class="skip-link" href="#main" data-i18n="a11y.skip">Skip to main content</a>
<header class="header">
  <div class="header__bar">
    <a class="header__logo logo" href="./index.html">
      <%- include('./icon.ejs', { name: 'chef', size: 28, className: 'logo__icon' }) %>
      <span class="logo__text"><%= site.name %></span>
    </a>
    <button class="header__toggle icon-button" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Open menu" data-i18n-aria-label="header.openMenu">
      <%- include('./icon.ejs', { name: 'menu' }) %>
    </button>
    <nav class="header__nav nav" id="main-nav" aria-label="Main" data-i18n-aria-label="nav.mainLabel">
      <ul class="nav__list">
        <% site.nav.forEach((item) => { const active = item.id === page; %>
        <li class="nav__item">
          <a class="nav__link<%= active ? ' nav__link--active' : '' %>" href="<%= item.href %>"<%- active ? ' aria-current="page"' : '' %> data-i18n="<%= item.i18n %>"><%= item.label %></a>
        </li>
        <% }) %>
      </ul>
      <a class="nav__cta button button--primary button--small" href="./index.html#generator">
        <%- include('./icon.ejs', { name: 'star', size: 14, filled: true }) %>
        <span data-i18n="header.generate">Generate recipe</span>
      </a>
    </nav>
  </div>
</header>
